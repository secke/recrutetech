# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=sk_d3196929f411f48e1e8f97ff1929ee0a6c3195e72b09c835
# Filled in by the bootstrap script after agent creation
ELEVENLABS_AGENT_ID=
# Set in the ElevenLabs dashboard (Webhooks tab) and copied here for HMAC verification
ELEVENLABS_WEBHOOK_SECRET=

# HR API key — required header (X-HR-API-Key) for /api/roles and /api/interviews.
# Leave empty in dev to bypass auth.
HR_API_KEY=

# Claude API — generates the HR evaluation + candidate improvement letter from the transcript.
# Leave empty to skip report generation (webhook still flips status to completed).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# SMTP — used to email candidates after their interview completes.
# Leave SMTP_HOST empty in dev to no-op (the webhook still flips status to completed).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=RecruteTech
SMTP_USE_TLS=true

# Public URLs (where this backend and the frontend are reachable)
PUBLIC_BACKEND_URL=http://localhost:8000
PUBLIC_FRONTEND_URL=http://localhost:5173

# CORS (comma-separated list)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional
DATABASE_URL=sqlite:///./recrutetech.db
ENVIRONMENT=development

# Feature flags — cv-adaptive-personalization skill
# Phase 1 silent rollout (default): the personalized prompt is computed and
# stored in Interview.personalized_prompt but NOT injected into the ElevenLabs
# agent override at session start. Set to True for Phase 2 opt-in injection.
# See docs/operations/cv-retention.md for the Phase 2 activation checklist.
CV_PERSONALIZATION_INJECT=False
